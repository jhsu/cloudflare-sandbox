{
  "name": "ai-sdk-sandbox-cloudflare",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.1",
  "private": false,
  "description": "Cloudflare Sandbox provider for AI SDK Harness",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@cloudflare/workers-types": "^4.20260615.1",
    "@types/node": "^25.9.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/harness": "^0.0.0",
    "@ai-sdk/provider-utils": "^4.0.29",
    "@cloudflare/sandbox": "^0.12.1"
  }
}
